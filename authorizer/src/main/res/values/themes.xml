<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Authorizer application themes (Material 3, day/night, dynamic colour aware).
  ~ Colour roles live in colors_m3.xml (values/ and values-night/). Both themes
  ~ below are generated from the same role table; keep them in sync.
  -->
<resources>

    <!-- Main theme: no window action bar, the activity provides a MaterialToolbar. -->
    <style name="Theme.Authorizer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>
        <item name="colorPrimaryFixed">@color/m3_primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/m3_primary_fixed_dim</item>
        <item name="colorOnPrimaryFixed">@color/m3_on_primary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/m3_on_primary_fixed_variant</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorSecondaryFixed">@color/m3_secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/m3_secondary_fixed_dim</item>
        <item name="colorOnSecondaryFixed">@color/m3_on_secondary_fixed</item>
        <item name="colorOnSecondaryFixedVariant">@color/m3_on_secondary_fixed_variant</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorTertiaryFixed">@color/m3_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/m3_tertiary_fixed_dim</item>
        <item name="colorOnTertiaryFixed">@color/m3_on_tertiary_fixed</item>
        <item name="colorOnTertiaryFixedVariant">@color/m3_on_tertiary_fixed_variant</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="preferenceTheme">@style/ThemeOverlay.Authorizer.Preference</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Authorizer.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.Authorizer.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <item name="android:spinnerStyle">@style/Widget.Authorizer.Spinner</item>
        <item name="android:listViewStyle">@style/Widget.Authorizer.ListView</item>
        <item name="drawableActionHome">@drawable/ic_arrow_back</item>
        <item name="drawableActionNavigationMoreVert">@drawable/ic_more_vert</item>
        <item name="drawableActionNewPassword">@drawable/ic_autorenew</item>
        <item name="drawableActionVisibility">@drawable/ic_visibility</item>
        <item name="drawableCloseCancel">@drawable/ic_close</item>
        <item name="drawableFolder">@drawable/ic_folder</item>
        <item name="drawableFolderUp">@drawable/ic_arrow_upward</item>
        <item name="drawablePasswdsafe">@drawable/ic_description</item>
        <item name="drawablePersonOutline">@drawable/ic_person</item>
        <item name="textColorGreen">@color/status_ok</item>
        <item name="customNavigationBarColor">?attr/colorSurfaceContainer</item>
    </style>

    <!-- Dialog-shaped activities (launcher shortcut pickers, OTP entry). -->
    <style name="Theme.Authorizer.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>
        <item name="colorPrimaryFixed">@color/m3_primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/m3_primary_fixed_dim</item>
        <item name="colorOnPrimaryFixed">@color/m3_on_primary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/m3_on_primary_fixed_variant</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorSecondaryFixed">@color/m3_secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/m3_secondary_fixed_dim</item>
        <item name="colorOnSecondaryFixed">@color/m3_on_secondary_fixed</item>
        <item name="colorOnSecondaryFixedVariant">@color/m3_on_secondary_fixed_variant</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorTertiaryFixed">@color/m3_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/m3_tertiary_fixed_dim</item>
        <item name="colorOnTertiaryFixed">@color/m3_on_tertiary_fixed</item>
        <item name="colorOnTertiaryFixedVariant">@color/m3_on_tertiary_fixed_variant</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="preferenceTheme">@style/ThemeOverlay.Authorizer.Preference</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Authorizer.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.Authorizer.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <item name="android:spinnerStyle">@style/Widget.Authorizer.Spinner</item>
        <item name="android:listViewStyle">@style/Widget.Authorizer.ListView</item>
        <item name="drawableActionHome">@drawable/ic_arrow_back</item>
        <item name="drawableActionNavigationMoreVert">@drawable/ic_more_vert</item>
        <item name="drawableActionNewPassword">@drawable/ic_autorenew</item>
        <item name="drawableActionVisibility">@drawable/ic_visibility</item>
        <item name="drawableCloseCancel">@drawable/ic_close</item>
        <item name="drawableFolder">@drawable/ic_folder</item>
        <item name="drawableFolderUp">@drawable/ic_arrow_upward</item>
        <item name="drawablePasswdsafe">@drawable/ic_description</item>
        <item name="drawablePersonOutline">@drawable/ic_person</item>
        <item name="textColorGreen">@color/status_ok</item>
        <item name="customNavigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Full-screen camera preview for scanning OTP QR codes. -->
    <style name="Theme.Authorizer.Scan" parent="Theme.Authorizer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="ThemeOverlay.Authorizer.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
    </style>

    <!-- Settings screens: every boolean preference renders as a Material switch. -->
    <style name="ThemeOverlay.Authorizer.Preference" parent="PreferenceThemeOverlay.v14.Material">
        <item name="switchPreferenceCompatStyle">@style/Preference.Authorizer.Switch</item>
        <item name="checkBoxPreferenceStyle">@style/Preference.Authorizer.SwitchAsCheckBox</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
        <item name="preferenceCategoryTitleTextAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Preference.Authorizer.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <style name="Preference.Authorizer.SwitchAsCheckBox" parent="Preference.CheckBoxPreference.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch_checkbox</item>
    </style>

</resources>
