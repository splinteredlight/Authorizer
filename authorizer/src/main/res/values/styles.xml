<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Widgets -->

    <style name="Widget.Authorizer.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="titleCentered">false</item>
    </style>

    <style name="Widget.Authorizer.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Authorizer.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Authorizer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Authorizer.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Action buttons for typing a field to the computer: the one warm
         (tertiary) element of the record screen. -->
    <style name="Widget.Authorizer.Button.AutoType" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
        <item name="iconTint">?attr/colorOnTertiaryContainer</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <style name="Widget.Authorizer.Button.AutoType.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
        <item name="iconTint">?attr/colorOnTertiary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <style name="Widget.Authorizer.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Authorizer.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner_outlined</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Authorizer.ListView" parent="Widget.AppCompat.ListView">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">?attr/selectableItemBackground</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>

    <style name="Widget.Authorizer.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- Text appearances -->

    <!-- Section heading inside a screen: quiet, sentence case, primary tint. -->
    <style name="TextAppearance.Authorizer.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Authorizer.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Authorizer.Value" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Authorizer.Password" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Authorizer.Otp" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Screen structure -->

    <!-- Rows of key/value information (times, FIDO details) -->
    <style name="Authorizer.DetailRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Authorizer.DetailLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">2</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Authorizer.Label</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Authorizer.DetailValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">3</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Input method (keyboard) -->
    <style name="InputMethodText">
        <!-- Should match the keyboard view's keyTextColor -->
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <!-- AndroidTreeView container: the node views bring their own padding -->
    <style name="TreeNodeStyleCustom">
        <item name="android:paddingLeft">0dp</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_weight">0</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="Preference_TextAppearanceMaterialBody2"
        tools:ignore="PrivateResource">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
</resources>
