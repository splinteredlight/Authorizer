<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Authorizer colours that are not Material 3 roles. The role table is in
  ~ colors_m3.xml. Names that appear here and in values-night/colors.xml are
  ~ theme-aware; keep the two files in step.
  -->
<resources>
    <!-- Adaptive launcher icon backdrop (brand teal, the M3 light primary). -->
    <color name="ic_launcher_background">#116682</color>

    <!-- Status colours: "ok" is used for saved-password and paired-device
         states, "warning" for passwords that expire soon. -->
    <color name="status_ok">#2E7D32</color>
    <color name="status_warning">#8A6A1E</color>

    <!-- Password rendering: digits and symbols are tinted so a revealed
         password can be read without mistaking 0/O or l/1. -->
    <color name="password_letter">@color/m3_on_surface</color>
    <color name="password_digit">@color/m3_primary</color>
    <color name="password_symbol">@color/m3_tertiary</color>

    <!-- Record icons stored in the .psafe3 file (Iconics fonts). -->
    <color name="record_icon">@color/m3_primary</color>
    <color name="record_icon_background">@color/m3_primary_container</color>

    <!-- Copied from the design compat library for the error text colour of
         plain (non-Material) widgets. -->
    <color name="textinput_error_color_light">#FFD50000</color>
    <color name="textinput_error_color_dark">#FFFF6E6E</color>

    <!-- Legacy names still referenced by layouts that have not moved to the
         Material 3 roles yet; aliases so both resolve to the same palette. -->
    <color name="text_lgray">@color/m3_on_surface_variant</color>
    <color name="treeview_icons">@color/record_icon</color>
    <color name="treeview_icons_background">@color/record_icon_background</color>
    <color name="menu_icon_color">@color/m3_on_surface_variant</color>
    <color name="primary">@color/m3_primary</color>
    <color name="accent">@color/m3_primary</color>
    <color name="colorAccent">@color/m3_primary</color>
    <color name="colorPrimary">@color/m3_primary</color>
    <color name="md_grey_100">#FFF5F5F5</color>
    <color name="md_grey_700">#FF616161</color>
    <color name="md_white_1000">#FFFFFFFF</color>
</resources>
