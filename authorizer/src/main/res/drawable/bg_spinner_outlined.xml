<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined-field look for the AppCompat spinners in the edit forms, with a
     trailing dropdown arrow, so they sit next to Material text fields. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="?attr/colorOutline"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="12dp"
        android:width="24dp" android:height="24dp"
        android:drawable="@drawable/ic_expand_more"/>
</layer-list>
