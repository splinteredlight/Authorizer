<?xml version="1.0" encoding="utf-8"?>
<!-- Expiry view: notification switch and the list of expiry filters. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="net.tjado.passwdsafe.PasswdSafeExpirationsFragment">

    <CheckBox android:id="@+id/enable_expiry_notifs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/screen_gutter"
        android:layout_marginStart="8dp"
        android:text="@string/enable_expiration_notifications"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:background="?attr/colorOutlineVariant"/>

    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="4dp"
        android:text="@string/view_password_expirations"
        android:textAppearance="@style/TextAppearance.Authorizer.Section"/>

    <ListView android:id="@+id/expirations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:entries="@array/expire_filters"/>

</LinearLayout>
