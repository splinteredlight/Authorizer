<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the entry tree: a group (chevron, folder, trailing count) or
     a record (tonal icon, trailing "type over USB" button). The spacer's
     width is set from the nesting level by PasswdRecordListItemHolder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <View
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="1dp"/>

    <com.mikepenz.iconics.view.IconicsTextView
        android:id="@+id/arrow_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="@string/ic_arrow_right"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="18sp"
        android:visibility="invisible"/>

    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_icon_container">

        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="20sp"/>
    </FrameLayout>

    <TextView
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"/>

    <TextView
        android:id="@+id/group_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/icon_usbkbd_output"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/autotype_usb_hold_hint"
        android:src="@drawable/ic_keyboard"
        app:tint="?attr/colorOnSurfaceVariant"/>

</LinearLayout>
